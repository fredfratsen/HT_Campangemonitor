# Copy the variables you need into your host's environment settings (Render: Environment tab).
# Locally you can export them in your shell before `npm run dev` / `npm start`.

# Encrypts stored API keys and two-factor secrets. Long random string; Render generates one via render.yaml.
# Don't change it once set.
SECRETS_KEY=

# Where the data files are stored. On Render: the mount path of the persistent disk.
DATA_DIR=./data

# Base URL for the setup/recovery links printed at startup. Optional (Render's URL is used automatically).
APP_URL=

# Trello (read-only). Optional fallback: normally set under Instellingen › Integraties in the app.
TRELLO_KEY=
TRELLO_TOKEN=

# Set to 1 only when the Dev account is locked out: prints password-reset links at startup. Remove afterwards.
OWNER_RECOVERY=

# Port (Render sets this automatically).
PORT=3000
