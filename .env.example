# Copy the variables you need into your host's environment settings (Render: Environment tab).
# Locally you can export them in your shell before `npm run dev` / `npm start`.

# Team password for the login page. Required in production.
APP_PASSWORD=

# Long random string used to sign login cookies. Render generates one via render.yaml.
SESSION_SECRET=

# Trello (read-only). See the "Trello-koppeling testen" page in the app for how to create these.
TRELLO_KEY=
TRELLO_TOKEN=

# Where the shared data file is stored. On Render: the mount path of the persistent disk.
DATA_DIR=./data

# Port (Render sets this automatically).
PORT=3000
